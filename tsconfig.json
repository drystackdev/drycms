{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    // `content-types/seed.ts` imports `dry.seed.json` directly - see its own
    // doc comment for why that has to be a static import rather than a read.
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["vite/client", "@types/bun"],
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts", "dry.config.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
