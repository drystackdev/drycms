# Authentication: use DRYCMS_SECRET_KEY for the default key, or configure a
# key ring for rotation. Every JWT secret must be at least 32 bytes.
DRYCMS_SECRET_KEY=replace-with-at-least-32-byte-secret
# Required only while creating the first administrator. Generate a random
# value of at least 32 characters and provide it in the setup form (or set
# EMAIL_ADMIN/PASSWORD_ADMIN below to skip the form entirely).
DRYCMS_BOOTSTRAP_TOKEN=replace-with-a-random-bootstrap-token
# Optional: if both are set (and DRYCMS_BOOTSTRAP_TOKEN above is configured),
# a fresh instance with no user yet auto-creates the first Super Admin from
# these instead of showing the /register form - useful for scripted/first-
# boot deployments. Password must be at least 12 characters. Ignored once an
# account already exists.
# EMAIL_ADMIN=admin@example.com
# PASSWORD_ADMIN=replace-with-a-strong-password
# If Node runs behind a TLS reverse proxy, set the public origin so secure
# cookies and redirects use the external HTTPS origin.
# DRYCMS_PUBLIC_ORIGIN=https://cms.example.com
# DRYCMS_TRUST_PROXY=true
# DRYCMS_ALLOWED_HOSTS=cms.example.com
DRYCMS_JWT_ACTIVE_KID=2026-08
DRYCMS_JWT_KEYS_JSON={"2026-08":"replace-with-at-least-32-byte-secret"}
