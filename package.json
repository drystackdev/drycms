{
  "name": "sivelap",
  "version": "0.0.1",
  "dependencies": {
    "@preact/signals": "^2.10.0",
    "dayjs": "^1.11.21",
    "dompurify": "^3.4.12",
    "fuzzysort": "^3.1.0",
    "marked": "^18.0.7",
    "overlayscrollbars": "^2.16.0",
    "preact": "^10.29.7",
    "preact-iso": "^2.12.1",
    "preact-render-to-string": "^6.7.0",
    "prism-code-editor": "^5.3.0",
    "prismjs": "^1.30.0",
    "prosemirror-commands": "^1.5.1",
    "prosemirror-history": "^1.3.0",
    "prosemirror-keymap": "^1.2.1",
    "prosemirror-model": "^1.19.0",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.2",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.10.5",
    "prosemirror-view": "^1.30.2",
    "sucrase": "^3.35.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.119",
    "@iconify-json/solar": "^1.2.5",
    "@iconify/utils": "^3.1.4",
    "@playwright/test": "^1.49.0",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/browser": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "@types/prismjs": "^1.26.6",
    "typescript": "^5.9.0",
    "vite": "^8.0.13",
    "vitest": "^3.2.0",
    "wrangler": "^4.118.0"
  },
  "description": "A self-hosted Preact CMS admin UI, served via a pluggable server adapter (Node or Cloudflare Workers; Bun planned).",
  "engines": {
    "node": ">=22.12.0",
    "bun": ">=1.3.14"
  },
  "overrides": {
    "rollup": "^4.62.2",
    "vite": "^8.0.13"
  },
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "build": "vite build --outDir dist/client && vite build --ssr src/server/entry-node.ts --outDir dist/server && bun scripts/build-seed-assets.ts",
    "start": "node dist/server/entry-node.js",
    "build:worker": "vite build --outDir dist/client && DRYCMS_WORKER_BUILD=1 vite build --ssr src/server/entry-worker.ts --outDir dist/server",
    "deploy": "bun run build:worker && wrangler deploy",
    "dev:worker": "bun run build:worker && wrangler dev",
    "r2:sync": "bun scripts/r2-sync-assets.ts",
    "build:icons": "node scripts/build-icons.mjs",
    "dry:generate": "bun scripts/dry-generate.ts",
    "new:project": "bun scripts/new-project.ts",
    "seed:sync": "bun scripts/seed-sync.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "type": "module"
}
