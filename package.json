{
  "name": "drycms-workspace",
  "type": "module",
  "private": true,
  "version": "0.0.1",
  "workspaces": ["packages/*"],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "bun run build:lib && astro dev",
    "build": "bun run build:lib && astro build",
    "build:lib": "bun run --cwd packages/drycms build",
    "dev:lib": "bun run --cwd packages/drycms dev",
    "preview": "astro preview",
    "test": "bun run --cwd packages/drycms test",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "^7.1.3",
    "drycms": "workspace:*",
    "preact": "^10.29.7"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
