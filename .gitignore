# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# drycms local data (all default local roots live under `.dry/`)
/.dry/

# Local `storage` root (uploaded media + dry-icons/ - see resolveStorageOption()
# in server/options.ts). Deliberately NOT carried through git: media reaches a
# deployment via `bun run r2:sync`, which uploads this directory straight into
# the R2 bucket the deployed Worker reads from (`scripts/r2-sync-assets.ts`).
# That makes R2 the durable copy for anything deployed - this directory is only
# the local working copy, so a fresh clone starts with no media until someone
# uploads some (or pulls it down from the bucket).
/public/

# Legacy root-level local data (kept ignored for upgrades from older defaults)
/storage/
/icons/
/content/
/components/
/richtext-components/

# `src/apps/pages` - build-time-only materialized copy of `pagesSourceStorage`
# (`.dry/pages-source` locally, R2 in prod), NOT hand-edited/committed
# anymore. `pagesSourceStorage` is the durable source (dev's app router reads
# it live - `route-tree.ts`'s `DevPagesSource`); `bun run build`/`build:worker`
# each run `bun scripts/sync-pages-r2.ts --pull [--remote]` to regenerate this
# directory right before `vite build`'s compile-time glob
# (`discoverRoutes()`'s prod branch) reads it - same "R2/storage is the
# durable copy, this is only the local working copy" reasoning `/public/`
# above already documents for media.
/src/apps/pages/

# Playwright artifacts (unanchored - a command run from the wrong cwd can
# create these under a subdirectory instead of the repo root)
test-results/
playwright-report/

# Legacy root-level SQLite database files
*.sqlite

