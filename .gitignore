# build output
dist/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# drycms local data (all default local roots live under `.dry/`)
/.dry/

# Local `storage` root (uploaded media + dry-icons/ - see resolveStorageOption()
# in server/options.ts). Deliberately NOT carried through git: media reaches a
# deployment via `bun run r2:sync`, which uploads this directory straight into
# the R2 bucket the deployed Worker reads from (`scripts/r2-sync-assets.ts`).
# That makes R2 the durable copy for anything deployed - this directory is only
# the local working copy, so a fresh clone starts with no media until someone
# uploads some (or pulls it down from the bucket).
/public/

# Legacy root-level local data (kept ignored for upgrades from older defaults)
/storage/
/icons/
/content/
/components/
/richtext-components/

# `src/apps/schema.json`/`src/apps/seed.json` - `bun run seed:sync`'s output
# (an app's own content types + singleton/menu data, built-in system
# defaults excluded - see `scripts/lib/schema-sync.ts`). Never imported by
# any runtime code (unlike the old, committed `dry.seed.json` this replaced -
# a static import of that file meant deleting it 500'd every page): these
# are plain local export/import artifacts, picked up on demand through the
# Content Types page's "Upload schema"/"Upload seed data" buttons instead.
/src/apps/schema.json
/src/apps/seed.json

# Playwright artifacts (unanchored - a command run from the wrong cwd can
# create these under a subdirectory instead of the repo root)
test-results/
playwright-report/

# Legacy root-level SQLite database files
*.sqlite

Sortable-master
drystack
.qa-tmp3
.codegraph
/kv/
.wrangler

#mcp
.playwright-mcp
.codegraph
