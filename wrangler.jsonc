{
  // Deploying drycms to Cloudflare Workers - see
  // `status/cloudflare-workers-adapter.md` for the full plan this
  // implements. The D1/R2/KV resources below already exist on the
  // `drystack.dev@gmail.com` account (`wrangler d1 create sivelap-db`,
  // `wrangler kv namespace create sivelap-session`; the `sivelap-content` R2
  // bucket was created earlier) - IDs filled in from their own create
  // output. The binding NAMES (`CONTENT_DB`/`MEDIA_BUCKET`/`KV`) are fixed,
  // not configurable -
  // the resolved `kind: "cloudflare"` toggle (`options.ts`'s `DryOption`,
  // auto-detected per-build - see `src/server/config.ts`) assumes exactly
  // these names on both sides of the contract; rename them here AND in
  // `options.ts` together if you need different ones for your own account.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "drycms",
  "main": "dist/server/entry-worker.js",
  "compatibility_date": "2026-08-01",
  // `node:stream`'s `Readable`/`Buffer` are used throughout `src/server/**`
  // and `src/storage/r2.ts` (same as the existing `kv/cloudflare-kv.ts`
  // Buffer usage) - required for all of it to run on workerd.
  "compatibility_flags": ["nodejs_compat"],

  // Serves the client build (`dist/client/**`, built by `bun run
  // build:worker`) - `entry-worker.ts` reads `env.ASSETS` for both real
  // static files and the admin shell's `index.html`.
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    // Cloudflare's asset layer answers a matching request BEFORE the Worker
    // ever runs, and `/` matches `dist/client/index.html` - which is the
    // ADMIN shell, not a site page. Without this, the site's own root page
    // (the published site root) is unreachable in production and `/`
    // serves the admin SPA instead. `entry-worker.ts` already excludes
    // `pathname === "/"` from its own asset branch for exactly this reason
    // (mirroring `entry-node.ts`'s `tryServeStaticAsset`), but that code
    // never got a chance to run. Scoped to `/` alone so every real asset
    // Asset requests also pass through `entry-worker.ts` so hashed files get
    // their immutable cache policy and JavaScript modules get the narrowly
    // scoped `Access-Control-Allow-Origin: null` required by the opaque
    // Page Builder preview. The Worker immediately delegates bytes to the
    // Assets binding; no asset content is rebuilt or buffered here.
    "run_worker_first": ["/", "/assets/*"]
  },

  // The resolved `kind: "cloudflare"` uses this for content (Node-only
  // `sqlite`, the `kind: "local"` default, has no Workers driver).
  "d1_databases": [
    {
      "binding": "CONTENT_DB",
      "database_name": "sivelap-db",
      "database_id": "a8f991b7-c53f-478a-a804-cb6ddac17f26"
    }
  ],

  // One shared bucket, key-prefixed per storage-backed root (`storage/`,
  // `icons/`, `richtext-components/`, `components/`, `pages-cache/`,
  // `types-cache/` - see `storage/r2.ts`'s doc comment) - the resolved
  // `kind: "cloudflare"` points every one of them at this same binding.
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "sivelap-content"
    }
  ],

  // The resolved `kind: "cloudflare"` uses this for the Key Value store
  // (`kv.kind: "local"`, the default under `kind: "local"`, has no Workers
  // driver either).
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "16181440544644f381297ff08ec46d16"
    }
  ]

  // No cron trigger needed: the page-level `schedule`/`publishAt` staged-
  // publish mechanism (`plans/app-r2.md` mục 9) was removed entirely
  // (2026-08-09) in favor of the entry-level `features.schedule` gate alone
  // - a build always publishes immediately now, nothing is ever "staged".
}
