{
  // Template for deploying drycms to Cloudflare Workers - see
  // `status/cloudflare-workers-adapter.md` for the full plan this
  // implements. Every ID below is a placeholder; fill them in with
  // `wrangler d1 create`/`wrangler r2 bucket create`/`wrangler kv namespace
  // create` output (or the dashboard) before `bun run deploy`. The binding
  // NAMES (`CONTENT_DB`/`MEDIA_BUCKET`/`KV`) are fixed, not configurable -
  // `dry.config.ts`'s single `kind: "cloudflare"` toggle (see `options.ts`'s
  // `DryOption`) assumes exactly these names on both sides of the
  // contract; rename them here AND in `options.ts` together if you need
  // different ones for your own account.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sivelap",
  "main": "dist/server/entry-worker.js",
  "compatibility_date": "2026-08-01",
  // `node:stream`'s `Readable`/`Buffer` are used throughout `src/server/**`
  // and `src/storage/r2.ts` (same as the existing `kv/cloudflare-kv.ts`
  // Buffer usage) - required for all of it to run on workerd.
  "compatibility_flags": ["nodejs_compat"],

  // Serves the client build (`dist/client/**`, built by `bun run
  // build:worker`) - `entry-worker.ts` reads `env.ASSETS` for both real
  // static files and the admin shell's `index.html`.
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    // Cloudflare's asset layer answers a matching request BEFORE the Worker
    // ever runs, and `/` matches `dist/client/index.html` - which is the
    // ADMIN shell, not a site page. Without this, the site's own root page
    // (`src/apps/pages/page.tsx`) is unreachable in production and `/`
    // serves the admin SPA instead. `entry-worker.ts` already excludes
    // `pathname === "/"` from its own asset branch for exactly this reason
    // (mirroring `entry-node.ts`'s `tryServeStaticAsset`), but that code
    // never got a chance to run. Scoped to `/` alone so every real asset
    // (`/assets/*`, images, ...) still comes straight off the asset layer
    // without spending a Worker invocation.
    "run_worker_first": ["/"]
  },

  // `dry.config.ts`'s `kind: "cloudflare"` uses this for content (Node-only
  // `sqlite`, the `kind: "local"` default, has no Workers driver).
  "d1_databases": [
    {
      "binding": "CONTENT_DB",
      "database_name": "sivelap-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],

  // One shared bucket, key-prefixed per storage-backed root (`storage/`,
  // `icons/`, `richtext-components/`, `components/`, `pages-cache/`,
  // `types-cache/` - see `storage/r2.ts`'s doc comment) - `dry.config.ts`'s
  // `kind: "cloudflare"` points every one of them at this same binding.
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "sivelap-content"
    }
  ],

  // `dry.config.ts`'s `kind: "cloudflare"` uses this for the Key Value store
  // (`kv.kind: "local"`, the default under `kind: "local"`, has no Workers
  // driver either).
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ]

  // `schedule` (`plans/app-r2.md` mục 9) no longer needs a cron trigger -
  // `page-handler.ts` promotes a due `_pages` row lazily, at request time,
  // on a live-key miss (see `status/app-r2-build.md`). If a periodic sweep
  // is ever needed again (e.g. to warm a page live before its first visitor
  // hits it), reinstate a `triggers.crons` block here.
}
