{
  "name": "drycms",
  "version": "0.0.1",
  "type": "module",
  "description": "A Preact-based CMS UI toolkit for Astro, styled with attribute-driven CSS.",
  "keywords": ["astro-integration", "astro-component", "cms", "preact"],
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./src/styles/index.css",
    "./styles/*": "./src/styles/*",
    "./app.astro": "./src/app.astro",
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    },
    "./pages/*": {
      "types": "./dist/pages/*.d.ts",
      "default": "./dist/pages/*.js"
    },
    "./routers/*": {
      "types": "./dist/routers/*.d.ts",
      "default": "./dist/routers/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:icons": "node scripts/build-icons.mjs",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/preact": "^6.0.1",
    "@victr/prism-live": "^0.0.6",
    "preact-iso": "^2.12.1",
    "prismjs": "^1.30.0",
    "simplebar": "^6.3.3"
  },
  "peerDependencies": {
    "astro": "^7.0.0",
    "preact": "^10.24.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.119",
    "@iconify-json/solar": "^1.2.5",
    "@iconify/utils": "^3.1.4",
    "@types/node": "^26.1.1",
    "@types/prismjs": "^1.26.6",
    "astro": "^7.1.3",
    "preact": "^10.29.7",
    "typescript": "^5.9.0",
    "vite": "^8.0.13",
    "vitest": "^3.2.0"
  }
}
