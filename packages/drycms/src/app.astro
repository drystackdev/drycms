---
export const prerender = false;

import App from "./routers/App";
import "drycms/styles.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>DryCMS</title>
    <style is:global>
      /* Astro's dev toolbar is a project-wide setting; hide it on the admin page only. */
      astro-dev-toolbar {
        display: none;
      }
    </style>
  </head>
  <body class="dry">
    {
      /* Applies the stored theme before first paint to avoid a flash.
		Reads the same `drycms:store.theme` entry that `useStore("theme", ...)`
		(see ThemeToggle) reads/writes. */
    }
    <script is:inline>
      try {
        const store = JSON.parse(localStorage.getItem(STORAGE_KEY) || "{}");
        const stored = store.theme;
        if (stored === "light" || stored === "dark") {
          document.body.classList.add(stored);
        }
      } catch {}
    </script>

    <App client:only="preact" />
  </body>
</html>
