---
import { type IconName, iconBodies, iconViewBoxes } from 'drycms/components/icons';

interface Props {
	name: IconName;
	size?: string;
	[key: string]: unknown;
}

const { name, size = '1em', ...rest } = Astro.props;

const body = iconBodies[name];
if (!body) {
	throw new Error(
		`[drycms] Unknown icon "${name}". Available: ${Object.keys(iconBodies).join(', ')}`,
	);
}
---

<svg
	viewBox={iconViewBoxes[name]}
	width={size}
	height={size}
	aria-hidden="true"
	{...rest}
	set:html={body}
/>
