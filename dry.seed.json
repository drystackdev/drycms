{
  "$schema": "./dry.seed.schema.json",
  "contentTypes": [
    {
      "id": "system-menu-item",
      "kind": "component",
      "name": "menuItem",
      "label": "Menu Item",
      "description": "One link in a menu.",
      "fields": [
        {
          "id": "system-menu-item-label",
          "name": "label",
          "label": "Label",
          "type": "text",
          "config": {},
          "validation": {
            "required": true
          },
          "order": 0
        },
        {
          "id": "system-menu-item-description",
          "name": "description",
          "label": "Description",
          "type": "text",
          "config": {
            "multiline": true
          },
          "validation": {},
          "order": 1
        },
        {
          "id": "system-menu-item-href",
          "name": "href",
          "label": "Href",
          "type": "text",
          "config": {},
          "validation": {
            "required": true,
            "format": "url"
          },
          "order": 2
        }
      ],
      "version": 1
    },
    {
      "id": "system-seo",
      "kind": "component",
      "name": "seo",
      "label": "SEO",
      "description": "Search-engine/social preview metadata.",
      "hidden": true,
      "locked": true,
      "fields": [
        {
          "id": "system-seo-meta-title",
          "name": "metaTitle",
          "label": "Title",
          "type": "text",
          "config": {},
          "validation": {},
          "order": 0
        },
        {
          "id": "system-seo-description",
          "name": "description",
          "label": "Description",
          "type": "text",
          "config": {
            "multiline": true
          },
          "validation": {},
          "order": 1
        },
        {
          "id": "system-seo-image",
          "name": "image",
          "label": "Image",
          "type": "image",
          "config": {},
          "validation": {},
          "order": 2
        },
        {
          "id": "system-seo-no-index",
          "name": "noIndex",
          "label": "Hide from search engines",
          "type": "boolean",
          "config": {},
          "validation": {},
          "default": false,
          "order": 3
        }
      ],
      "version": 1
    },
    {
      "id": "system-user",
      "kind": "collection",
      "name": "user",
      "label": "User",
      "description": "Accounts able to sign in.",
      "features": {
        "timestamps": true
      },
      "hidden": true,
      "locked": true,
      "protectedFieldIds": [
        "system-user-email",
        "system-user-password",
        "system-user-roles"
      ],
      "fields": [
        {
          "id": "system-user-name",
          "name": "name",
          "label": "Name",
          "type": "text",
          "config": {},
          "validation": {
            "required": true
          },
          "order": 0
        },
        {
          "id": "system-user-email",
          "name": "email",
          "label": "Email",
          "type": "text",
          "config": {},
          "validation": {
            "required": true,
            "unique": true,
            "format": "email"
          },
          "order": 1
        },
        {
          "id": "system-user-password",
          "name": "password",
          "label": "Password",
          "type": "password",
          "config": {},
          "validation": {
            "required": true
          },
          "order": 2
        },
        {
          "id": "system-user-roles",
          "name": "roles",
          "label": "Roles",
          "type": "relation",
          "config": {
            "target": "system-role",
            "cardinality": "manyToMany"
          },
          "validation": {},
          "order": 3
        }
      ],
      "version": 1
    },
    {
      "id": "system-menu",
      "kind": "collection",
      "name": "menu",
      "label": "Menu",
      "description": "A named group of links, e.g. the site's main navigation.",
      "features": {
        "timestamps": true
      },
      "fieldSides": {
        "system-menu-refs": "left"
      },
      "fields": [
        {
          "id": "system-menu-name",
          "name": "name",
          "label": "Name",
          "type": "text",
          "config": {},
          "validation": {
            "required": true,
            "unique": true
          },
          "order": 0
        },
        {
          "id": "system-menu-refs",
          "name": "refs",
          "label": "Items",
          "type": "component",
          "config": {
            "componentId": "system-menu-item",
            "repeatable": true,
            "sortable": true
          },
          "validation": {},
          "order": 1
        }
      ],
      "version": 1
    },
    {
      "id": "system-ai-key-management",
      "kind": "collection",
      "name": "aiKey",
      "label": "AI Key",
      "description": "Credentials for third-party AI providers.",
      "hidden": true,
      "locked": true,
      "frozen": true,
      "features": {
        "sortable": true
      },
      "fields": [
        {
          "id": "system-ai-key-management-name",
          "name": "name",
          "label": "Name",
          "type": "text",
          "config": {},
          "validation": {
            "required": true
          },
          "order": 0
        },
        {
          "id": "system-ai-key-management-description",
          "name": "description",
          "label": "Description",
          "type": "text",
          "config": {
            "multiline": true
          },
          "validation": {},
          "order": 1
        },
        {
          "id": "system-ai-key-management-provider",
          "name": "provider",
          "label": "Provider",
          "type": "select",
          "config": {
            "options": [
              "Google",
              "Anthropic",
              "ChatGPT",
              "Custom"
            ],
            "multiple": false
          },
          "validation": {
            "required": true
          },
          "order": 2
        },
        {
          "id": "system-ai-key-management-model",
          "name": "model",
          "label": "Model",
          "type": "select",
          "config": {
            "options": [],
            "multiple": true
          },
          "validation": {
            "required": true
          },
          "order": 3
        },
        {
          "id": "system-ai-key-management-key",
          "name": "key",
          "label": "Key",
          "type": "secretkey",
          "config": {},
          "validation": {
            "required": true
          },
          "order": 4
        },
        {
          "id": "system-ai-key-management-url",
          "name": "url",
          "label": "URL",
          "type": "text",
          "config": {},
          "validation": {
            "format": "url"
          },
          "order": 5
        }
      ],
      "version": 1
    },
    {
      "id": "system-role",
      "kind": "collection",
      "name": "role",
      "label": "Role",
      "description": "A named set of permissions users can be assigned.",
      "hidden": true,
      "locked": true,
      "frozen": true,
      "fields": [
        {
          "id": "system-role-name",
          "name": "name",
          "label": "Name",
          "type": "text",
          "config": {},
          "validation": {
            "required": true,
            "unique": true
          },
          "order": 0
        },
        {
          "id": "system-role-description",
          "name": "description",
          "label": "Description",
          "type": "text",
          "config": {
            "multiline": true,
            "placeholder": "e.g. Can edit blog posts but not publish them"
          },
          "validation": {},
          "order": 1
        },
        {
          "id": "system-role-is-super-admin",
          "name": "isSuperAdmin",
          "label": "Super Admin",
          "type": "boolean",
          "config": {},
          "validation": {},
          "default": false,
          "order": 2
        },
        {
          "id": "system-role-permissions",
          "name": "permissions",
          "label": "Permissions",
          "type": "select",
          "config": {
            "options": [],
            "multiple": true
          },
          "validation": {},
          "order": 3
        }
      ],
      "version": 1
    },
    {
      "id": "system-redirect",
      "kind": "collection",
      "name": "redirect",
      "label": "Redirect",
      "description": "Automatic 301 redirects, created when a slugged entry's slug changes.",
      "hidden": true,
      "locked": true,
      "frozen": true,
      "fields": [
        {
          "id": "system-redirect-from",
          "name": "from",
          "label": "From",
          "type": "text",
          "config": {},
          "validation": {
            "required": true,
            "unique": true
          },
          "order": 0
        },
        {
          "id": "system-redirect-to",
          "name": "to",
          "label": "To",
          "type": "text",
          "config": {},
          "validation": {
            "required": true
          },
          "order": 1
        }
      ],
      "version": 1
    },
    {
      "id": "system-seo-defaults",
      "kind": "singleton",
      "name": "seoDefaults",
      "label": "SEO Defaults",
      "description": "Site-wide fallback SEO, used by any page that doesn't set its own.",
      "hidden": true,
      "locked": true,
      "features": {
        "seo": true
      },
      "fields": [],
      "version": 1
    },
    {
      "id": "system-memory",
      "kind": "collection",
      "name": "memory",
      "label": "Memory",
      "description": "Per-account synced preferences/history - server-managed only.",
      "hidden": true,
      "locked": true,
      "frozen": true,
      "fields": [
        {
          "id": "system-memory-user",
          "name": "user",
          "label": "User",
          "type": "relation",
          "config": {
            "target": "system-user",
            "cardinality": "manyToOne"
          },
          "validation": {
            "required": true
          },
          "order": 0
        },
        {
          "id": "system-memory-data",
          "name": "data",
          "label": "Data",
          "type": "text",
          "config": {
            "multiline": true
          },
          "validation": {},
          "order": 1
        },
        {
          "id": "system-memory-version",
          "name": "version",
          "label": "Version",
          "type": "number",
          "config": {
            "step": 1
          },
          "validation": {
            "required": true
          },
          "default": 0,
          "order": 2
        }
      ],
      "version": 1
    },
    {
      "id": "system-settings",
      "kind": "singleton",
      "name": "systemSettings",
      "label": "System Settings",
      "description": "Admin UI theme (colors/typography), shared by every user - Super Admin only.",
      "hidden": true,
      "locked": true,
      "frozen": true,
      "fields": [
        {
          "id": "system-settings-data",
          "name": "data",
          "label": "Data",
          "type": "text",
          "config": {
            "multiline": true
          },
          "validation": {},
          "order": 0
        }
      ],
      "version": 1
    },
    {
      "id": "system-google-verification",
      "kind": "singleton",
      "name": "googleVerification",
      "label": "Google Verification",
      "description": "Serves Google's site-ownership verification content at the exact domain root, without an uploaded file.",
      "hidden": true,
      "locked": true,
      "frozen": true,
      "fields": [
        {
          "id": "system-google-verification-name",
          "name": "name",
          "label": "Name",
          "type": "text",
          "description": "The exact filename Google Search Console gives you, e.g. google1234567890abcdef.html - served at https://yourdomain.com/<name>.",
          "config": {
            "placeholder": "google1234567890abcdef.html"
          },
          "validation": {
            "required": true
          },
          "order": 0
        },
        {
          "id": "system-google-verification-content",
          "name": "content",
          "label": "Content",
          "type": "text",
          "description": "The exact file content Google gives you alongside the filename above - served verbatim as the response body.",
          "config": {
            "multiline": true,
            "placeholder": "google-site-verification: google1234567890abcdef.html"
          },
          "validation": {
            "required": true
          },
          "order": 1
        }
      ],
      "version": 1
    }
  ]
}
